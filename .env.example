# ── Server ──────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulsetix
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/pulsetix_test
DB_POOL_MAX=10

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────
# Must be at least 32 chars; generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_char_secret_here_XXXXX
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# ── Organizer Registration ───────────────────────────
# Share this code with graders; wrong code → 403
ORGANIZER_SIGNUP_CODE=replace_with_organizer_code

# ── SMTP (Brevo recommended; use Mailtrap for load tests) ───
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM=noreply@pulsetix.example.com

# ── Background Jobs ──────────────────────────────────
EMAIL_RATE_PER_SEC=10
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=100

# ── Rate Limiting ─────────────────────────────────────
# Set to false during benchmark runs
RATE_LIMIT_ENABLED=true
BOOKING_RATE_LIMIT_PER_MIN=60

# ── Metrics ───────────────────────────────────────────
# Protect /api/metrics with this token
METRICS_TOKEN=replace_with_metrics_token_here_XXXXX

# ── V1 Naive Booking (for baseline benchmark only) ───
# NEVER enable in production; enable only for the V1 benchmark run
ENABLE_NAIVE=false
